{
  "name": "study-abroad-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "vercel-build": "prisma generate && prisma db push --accept-data-loss && node scripts/seed-careers.mjs && node scripts/import-institutions.mjs && node scripts/import-wikidata.mjs && next build",
