generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COUNSELOR
  STUDENT
  UNIVERSITY_ADMIN
}

enum TestAssignmentStatus {
  ASSIGNED
  COMPLETED
}

enum ProfileLevel {
  EMPTY
  PARTIAL
  DEVELOPING
  COMPLETE
}

enum TraitDimension {
  INTEREST
  PERSONALITY
  APTITUDE
  SUBJECT
  SKILL
  WORK_ENVIRONMENT
  EDUCATION
}

enum TestStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  TEST_COMPLETED
  APPOINTMENT_SCHEDULED
  APPOINTMENT_REMINDER
  FEATURE_REQUEST
  SYSTEM
}

enum StudentStatus {
  ONLINE
  IN_TEST
  OFFLINE
}

enum ChatStatus {
  PENDING
  ACTIVE
  CLOSED
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  subdomain    String   @unique
  customDomain String?  @unique
  logoUrl      String?
  brandName    String?
  primaryColor String   @default("#0F172A")
  accentColor  String   @default("#3B82F6")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users User[]
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            Role     @default(STUDENT)
  isActive        Boolean  @default(true)
  avatarUrl       String?
  logoUrl         String?
  lastSeen          DateTime?
  totalUsageMinutes Float      @default(0)
  lastHeartbeatAt   DateTime?
  tenantId          String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  counselorProfile        CounselorProfile?
  studentProfile          StudentProfile?
  sentNotifications       Notification[]    @relation("SentBy")
  receivedNotifications   Notification[]    @relation("SentTo")
  appointmentsAsUser      Appointment[]     @relation("AppointmentUser")
  appointmentsAsCounselor Appointment[]     @relation("CounselorAppointments")
  createdTests            Test[]
  dailyUsage              DailyUsage[]
  chatsAsStudent          Chat[]            @relation("StudentChats")
  chatsAsCounselor        Chat[]            @relation("CounselorChats")
  messages                Message[]
  testAssignments         TestAssignment[]  @relation("StudentTestAssignments")
  createdTestAssignments  TestAssignment[]  @relation("CreatedTestAssignments")
  careerProfile           StudentCareerProfile?

  @@index([tenantId])
  @@index([email])
  @@index([role])
}

model CounselorProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String?
  bio                String?
  phone              String?
  whatsappCountryCode String?
  whatsappNumber     String?
  calendarId         String?
  counsellingPrice   Int      @default(2000)
  assessmentPrice    Int      @default(4000)
  indiaPrice         Int      @default(14000)
  internationalPrice Int      @default(95000)
  upiId              String?
  students           StudentProfile[] @relation("AssignedCounselor")
  paymentProofs      PaymentProof[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model StudentProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  counselorId   String?
  counselor     CounselorProfile? @relation("AssignedCounselor", fields: [counselorId], references: [id])
  dateOfBirth   DateTime?
  mobile        String?
  gender        String?
  gradeLevel    String?
  studyLevel    String?
  exams         String[]  @default([])
  subjectsStudied  String[] @default([])
  subjectsEnjoyed  String[] @default([])
  activityInterests String[] @default([])
  nationality   String?
  state         String?
  hasEnglishResult Boolean @default(false)
  englishTestType   String?
  englishTestScore  String?
  englishProficiency String?
  tuitionBudget String?
  fundingSource String?
  preferredIntake String?
  preferredYear String?
  highestEducation String?
  averageGrade  String?
  careerPlanNotes String?
  targetCountry String?
  targetColleges String[]
  targetCountries String[]
  preferredCareer String?
  prospectiveSessions String[]
  careerPrefsFilled Boolean @default(false)
  status        StudentStatus @default(OFFLINE)
  featureAccess StudentFeatureAccess?
  testResults   TestResult[]
  appointments  Appointment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([counselorId])
}

model StudentFeatureAccess {
  id               String  @id @default(cuid())
  studentProfileId String  @unique
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  collegeSearch    Boolean @default(false)
  collegeFinder    Boolean @default(false)
  aiOddsCalculator Boolean @default(false)
  mockTests        Boolean @default(false)
  scholarshipHub   Boolean @default(false)
  appointments     Boolean @default(false)
  webinars         Boolean @default(false)
  analytics        Boolean @default(false)
  careerLibrary    Boolean @default(false)
  chat             Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([studentProfileId])
}

model Test {
  id           String     @id @default(cuid())
  tenantId     String
  title        String
  description  String?
  subject      String
  durationMins Int
  totalMarks   Int
  status       TestStatus @default(DRAFT)
  createdById  String
  createdBy    User       @relation(fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  results TestResult[]

  @@index([tenantId])
}

model TestResult {
  id                String   @id @default(cuid())
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testId            String
  test              Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  score             Int
  totalMarks        Int
  percentage        Float
  answers           Json?
  submittedAt       DateTime @default(now())
  notifiedCounselor Boolean  @default(false)

  @@index([studentId])
  @@index([testId])
}

model TestAssignment {
  id                String               @id @default(cuid())
  tenantId          String
  studentId         String
  student           User                 @relation("StudentTestAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  assignedById      String
  assignedBy        User                 @relation("CreatedTestAssignments", fields: [assignedById], references: [id])
  kind              String
  token             String               @unique
  status            TestAssignmentStatus @default(ASSIGNED)
  answers           Json?
  result            Json?
  assessmentVersion String               @default("1.0")
  profileProcessedAt DateTime?
  createdAt         DateTime             @default(now())
  completedAt       DateTime?

  @@index([tenantId])
  @@index([studentId])
}
model StudentCareerProfile {
  id               String       @id @default(cuid())
  studentId        String       @unique
  student          User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  profileVersion   String       @default("1.0")
  completeness     Float        @default(0)
  assessmentCompleteness Float  @default(0)
  level            ProfileLevel @default(EMPTY)
  primaryInterests String[]     @default([])
  strengths        String[]     @default([])
  metadata         Json?
  lastCalculatedAt DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  signals StudentCareerSignal[]

  @@index([studentId])
}

model StudentCareerSignal {
  id                 String         @id @default(cuid())
  profileId          String
  profile            StudentCareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dimension          TraitDimension
  value              String
  score              Float
  sourceType         String         @default("ASSESSMENT")
  sourceAssessment   String?
  sourceAssignmentId String?
  sourceVersion      String         @default("1.0")
  confidence         Float          @default(1)
  metadata           Json?

  @@unique([profileId, dimension, value, sourceType])
  @@index([dimension, value])
  @@index([profileId])
}

model Appointment {
  id           String             @id @default(cuid())
  studentId    String
  student      StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  counselorId  String
  counselor    User               @relation("CounselorAppointments", fields: [counselorId], references: [id])
  userId       String
  user         User               @relation("AppointmentUser", fields: [userId], references: [id])
  title        String
  package      String?
  description  String?
  startTime    DateTime
  endTime      DateTime
  meetLink     String?
  amount       Int?
  status       AppointmentStatus  @default(PENDING)
  paymentProof PaymentProof?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([counselorId])
  @@index([studentId])
  @@index([startTime])
}

model PaymentProof {
  id             String      @id @default(cuid())
  appointmentId  String      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fileUrl        String
  fileName       String
  verified       Boolean     @default(false)
  counselorId    String
  counselor      CounselorProfile @relation(fields: [counselorId], references: [id])
  createdAt      DateTime    @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
  @@index([counselorId])
}

model Chat {
  id          String     @id @default(cuid())
  studentId   String
  student     User       @relation("StudentChats", fields: [studentId], references: [id])
  counselorId String
  counselor   User       @relation("CounselorChats", fields: [counselorId], references: [id])
  status      ChatStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  messages    Message[]

  @@index([studentId])
  @@index([counselorId])
  @@index([status])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

model University {
  id                   String   @id @default(cuid())
  tenantId             String
  name                 String
  country              String
  region               String?
  qsRank               Int?
  previousRank         Int?
  status               String?
  size                 String?
  focus                String?
  research             String?
  overallScore         Float?
  academicRepScore     Float?
  employerRepScore     Float?
  facultyStudentScore  Float?
  citationsScore       Float?
  intlFacultyScore     Float?
  intlStudentScore     Float?
  employmentScore      Float?
  sustainabilityScore  Float?
  domains              String[] @default([])
  webPages             String[] @default([])
  logoUrl              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId])
  @@index([country])
}

model IndianInstitution {
  id                    String  @id @default(cuid())
  aisheCode             String? @unique
  wdId                  String? @unique
  name                  String
  type                  String
  state                 String
  district              String?
  website               String?
  yearOfEstablishment   String?
  location              String?
  institutionType       String?
  management            String?
  universityAisheCode   String?
  universityName        String?
  source                String  @default("aishe")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([type, state])
  @@index([name])
  @@index([state])
  @@index([source])
}

model Career {
  id                  String   @id @default(cuid())
  name                String   @unique
  slug                String   @unique
  title               String
  category            String?
  subcategory         String?
  shortDescription    String?
  introduction        String
  whoShouldPursue     String[]
  eligibility         String[]
  workNatureDesc      String
  workNatureExamples  String[]
  demandLevel         String
  salaryCurrency      String
  salaryEntry         String
  salaryMedian        String?
  salarySenior        String
  jobGrowth           String
  topIndustries       String[]
  futureOutlook       String
  minStudyLevel       String?
  technicalSkills     String[] @default([])
  softSkills          String[] @default([])
  interests           String[] @default([])
  personalityTraits   String[] @default([])
  recommendedDegrees  String[] @default([])
  recommendedSubjects String[] @default([])
  toolsAndTechnologies String[] @default([])
  workActivities      String[] @default([])
  workEnvironment     String?
  careerPath          String[] @default([])
  automationRisk      String?
  indiaRelevance      String?
  globalRelevance     String?
  remotePotential     String?
  relatedCareers      String[] @default([])
  alternativeCareers  String[] @default([])
  isEmerging          Boolean  @default(false)
  isActive            Boolean  @default(true)
  seoTitle            String?
  seoDescription      String?
  seoKeywords         String[]
  faqs                Json
  pathways            Json
  conventionalOptions Json
  newAgeOptions       Json
  aiRelatedOptions    Json
  videoRecommendations Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  traits CareerTrait[]
  careerEducationPathways CareerEducationPathway[]

  @@index([name])
  @@index([demandLevel])
  @@index([category])
@@index([isActive])
 }

 model CareerTrait {
   id        String         @id @default(cuid())
   careerId  String
   career    Career         @relation(fields: [careerId], references: [id], onDelete: Cascade)
   dimension TraitDimension
   value     String
   weight    Float          @default(1)

   @@unique([careerId, dimension, value])
   @@index([dimension, value])
   @@index([careerId])
 }

 model Degree {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  educationLevel String   @default("Bachelor's")
  description   String?
  duration      String?
  eligibility   String?
  category      String   @default("Undergraduate")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
@@index([isActive])
  careerEducationPathways CareerEducationPathway[]
  specializations Specialization[]
}

 model Specialization {
  id            String   @id @default(cuid())
  name          String
  slug          String
  degreeId      String
  degree        Degree     @relation(fields: [degreeId], references: [id], onDelete: Cascade)
  description   String?
  isPrimary     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([degreeId, name])
@@index([degreeId])
  careerEducationPathways CareerEducationPathway[]
}

 model Subject {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  aliasOf       String?  
  description   String?
  category      String   @default("Academic")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
@@index([isActive])
  careerEducationPathways CareerEducationPathway[]
}

model CareerEducationPathway {
  id               String   @id @default(cuid())
  careerId         String
  career           Career     @relation(fields: [careerId], references: [id], onDelete: Cascade)
  degreeId         String?
  degree           Degree?    @relation(fields: [degreeId], references: [id], onDelete: Cascade)
  specializationId String?
  specialization   Specialization? @relation(fields: [specializationId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject?   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  priority         String     @default("ALTERNATIVE") // PRIMARY, ALTERNATIVE, OPTIONAL
  notes            String?
  type             String     @default("DEGREE_PATHWAY") // DEGREE_PATHWAY, SUBJECT_LINK

  @@index([careerId])
  @@index([degreeId])
  @@index([specializationId])
  @@index([subjectId])
  @@index([priority])
  @@index([type])
}

model EducationInstitutionMapping {
  id                   String   @id @default(cuid())
  degreeId             String?
  specializationId     String?
  universityId         String?
  indianInstitutionId  String?
  mappingType          String   @default("CATEGORY_DERIVED")
  confidence           Float    @default(0)
  source               String   @default("system")
  notes                String?
  createdAt            DateTime @default(now())

  @@index([degreeId])
  @@index([specializationId])
  @@index([universityId])
  @@index([indianInstitutionId])
}

model CareerTrend {
  id                String   @id @default(cuid())
  careerId          String
  period            String   @default("2026")
  region            String   @default("GLOBAL")
  trendScore        Float    @default(0)
  demandIndicator   String?
  growthIndicator   String?
  trending          Boolean  @default(false)
  emerging          Boolean  @default(false)
  fastGrowing       Boolean  @default(false)
  futureFacing      Boolean  @default(false)
  source            String   @default("SYSTEM_DERIVED")
  sourceUrl         String?
  methodology       String?
  recordedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([careerId, period, region, source])
  @@index([careerId])
  @@index([period])
  @@index([trending])
  @@index([emerging])
  @@index([fastGrowing])
  @@index([futureFacing])
  @@index([region])
}

model CounselorNote {
  id          String   @id @default(cuid())
  studentId   String
  counselorId String
  type        String   @default("GENERAL")
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([counselorId])
  @@index([type])
}

model CounselorAction {
  id          String     @id @default(cuid())
  studentId   String
  counselorId String
  type        String     @default("GENERAL")
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean    @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([studentId])
  @@index([counselorId])
  @@index([completed])
  @@index([dueDate])
}

model CounselorRecommendationFeedback {
  id                 String   @id @default(cuid())
  studentId          String
  counselorId        String
  recommendationType String
  careerId           String?
  institutionId      String?
  institutionType    String?
  decision           String
  note               String?
  createdAt          DateTime @default(now())

  @@index([studentId])
  @@index([counselorId])
  @@index([recommendationType])
  @@index([careerId])
  @@index([institutionId])
}

model StudentShortlist {
  id        String   @id @default(cuid())
  studentId String
  itemType  String
  itemId    String
  note      String?
  createdAt DateTime @default(now())

  @@unique([studentId, itemType, itemId])
  @@index([studentId])
  @@index([itemType, itemId])
}

model DailyUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  totalMinutes Float      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  linkUrl     String?
  read        Boolean          @default(false)
  senderId    String?
  sender      User?            @relation("SentBy", fields: [senderId], references: [id])
  recipientId String
  recipient   User             @relation("SentTo", fields: [recipientId], references: [id])
  createdAt   DateTime         @default(now())

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}
